$TTL 3600
@       IN  SOA ns1.optout.dnssec.test. hostmaster.optout.dnssec.test. (
                2026072501 ; serial
                7200       ; refresh
                3600       ; retry
                1209600    ; expire
                3600 )     ; minimum
@       IN  NS   ns1.optout.dnssec.test.
ns1     IN  A    192.0.2.54
a       IN  A    192.0.2.13
aaaa    IN  AAAA 2001:db8::13
txt     IN  TXT  "signed by BIND with RSASHA256 (NSEC3 opt-out)"
*.wild  IN  A    192.0.2.77
insecure      IN  NS   ns1.insecure
ns1.insecure  IN  A    192.0.2.90
